{
  "name": "@phreshos/core",
  "version": "0.1.38",
  "description": "Environment-neutral contracts and domain objects for PhreshOS Programs.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhreshOS/core.git"
  },
  "bugs": {
    "url": "https://github.com/PhreshOS/core/issues"
  },
  "homepage": "https://github.com/PhreshOS/core#readme",
  "keywords": [
    "phreshos",
    "sdk",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify:completions": "node scripts/verify-completions.mjs",
    "test": "vitest run",
    "build": "node --run clean && tsc --noEmit false --outDir dist --rootDir source",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "node --run check && node --run verify:completions && node --run test && node --run build && node --run verify:package",
    "prepack": "node --run test && node --run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  }
}
